# Секрет для доступа к приватному Docker-реестру (imagePullSecrets).
#
# Не редактируй этот файл руками — сгенерируй настоящий gitlab-registry-secret.yaml
# командой ниже (она сама соберёт правильный .dockerconfigjson):
#
#   kubectl create secret docker-registry gitlab-registry-secret \
#     --namespace todo-app \
#     --docker-server=<REGISTRY_HOST>:<PORT> \
#     --docker-username=<USERNAME> \
#     --docker-password=<TOKEN> \
#     --dry-run=client -o yaml > k8s/gitlab-registry-secret.yaml
